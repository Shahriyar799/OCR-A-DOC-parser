# Optional. Without this key, the application extracts embedded PDF text and
# applies conservative local patterns. With it, scanned documents can be read
# through a vision model and mapped to the fields below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Maximum accepted upload size in MiB. Keep this deliberately modest for a VPS.
MAX_UPLOAD_MB=15

# Public host port for the temporary VPS test.  Do not use 80/443 here.
HOST_PORT=8090
